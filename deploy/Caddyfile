# deploy/Caddyfile — TLS 終端とリバースプロキシ。
#
# ブラウザは https のページから ws:// に繋げないので wss:// が必須。
# Caddy は Let's Encrypt の取得・更新を自動でやる（WebSocket の upgrade も素通し）。
#
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# 事前に必要なこと:
#   - FreeDNS(afraid.org) 等で takoda99.mooo.com を取り、VM の【静的】外部IPへ向ける
#   - VM 作成時に「HTTPトラフィックを許可」「HTTPSトラフィックを許可」へチェック（80/443）
#     80 は Let's Encrypt の取得に要るので閉じないこと
#   - サーバー本体は 8080 で listen したまま、外部には公開しない
#
# Textro99 とは別ドメイン・別VMにする（同居させると 1GB/0.25vCPU を奪い合う）。

takoda99.mooo.com {
	reverse_proxy localhost:8080
}

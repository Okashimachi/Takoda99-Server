# deploy/takoda99.service — GCP Compute Engine 用 systemd unit。
# 想定: e2-micro / us-west1-b / Ubuntu 24.04 LTS（Always Free 枠）
#
#   sudo cp deploy/takoda99.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now takoda99
#
# 秘密（DATABASE_URL 等）はこのファイルに書かない。/etc/takoda99.env に置く（権限600）。
# 手順の全体は docs/deploy.md。

[Unit]
Description=Takoda99 game server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=takoda99
Group=takoda99
ExecStart=/opt/takoda99/server --mode match
WorkingDirectory=/opt/takoda99

# 秘密はここから読む（git に入れない。権限600・所有者root）。
EnvironmentFile=/etc/takoda99.env

# 一斉接続で小さい alloc が大量に出るため GC のトリガ間隔を広げる（Plan-09）。
Environment=GOGC=200
# e2-micro は共有vCPUなので、Goのスレッド数を絞って競合を減らす。
Environment=GOMAXPROCS=2

# 落ちても上げ直す（Render の supervisor がやっていた役割）。
Restart=always
RestartSec=2

# 試合状態は in-memory なので、停止＝進行中の試合の消滅。
# 落とす時は試合の合間を狙う（docs/deploy.md 参照）。
KillSignal=SIGTERM
TimeoutStopSec=20

# 最小権限。静的バイナリなので書き込み先も要らない。
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
